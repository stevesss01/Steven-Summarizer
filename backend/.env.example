# One key, or several comma-separated keys to spread rate limits
GROQ_API_KEY=
# GROQ_API_KEYS=key_one,key_two

GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.3
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

SINGLE_PASS_CHARS=12000
CHUNK_CHARS=8000
CHUNK_OVERLAP_CHARS=400
MAX_CONCURRENCY=3
MAX_DOCUMENT_CHARS=120000
MAX_PAGES=200

MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=10
ALLOWED_ORIGINS=http://localhost:5173,https://steven-summarizer.vercel.app
LOG_LEVEL=INFO
